{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apple SAT",
  "version": "0.2.0",
  "identifier": "com.bobananaa.applesat",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Apple SAT",
        "width": 1280,
        "height": 860,
        "minWidth": 750,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/libraries/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "Turn your official SAT results into a daily study path.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2QkJCNTIzOEQwNDFDNDgKUldSSUhBU05JN1c3MXJERThVZWNwVE1MOWk4SEhvb1Z1eWgxQWdZT0JsNm5pQkJzMkt4QTB0c1EK",
      "endpoints": [
        "https://github.com/boBananaa/apple-study-sat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
